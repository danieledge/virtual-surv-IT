/* The launcher's Textual tier.

   The whole look lives here, as a diffable stylesheet with live reload - which is the
   argument for this tier existing at all, rather than more hand-drawn ANSI.

   Target: a modern VT terminal (Windows Terminal on Win11, VS Code, iTerm2, ...).
   There is deliberately no 16-colour or ASCII variant: the tiers BELOW this one are
   the fallback, and maintaining two visual designs is what produced the 373-line
   hand-drawn tui_chrome.py. */

Screen {
    background: #0d0d10;
    color: #e6e6e6;
}

/* Overflow should be quiet. The default scrollbar is a bright slab that reads as an
   error the moment a short terminal clips a row. */
* {
    scrollbar-size-vertical: 1;
    scrollbar-background: #0d0d10;
    scrollbar-color: #2a2a31;
    scrollbar-color-hover: #3d3d47;
    scrollbar-color-active: #d97757;
}

#shell {
    padding: 1 3;
    height: 100%;
}

#brand {
    height: 5;
    margin-bottom: 1;
}

#panes {
    height: 1fr;
}

#panes > #panel {
    width: 1fr;
    background: #191920;
    border: round #2a2a31;
    border-title-color: #6b7280;
    border-title-align: right;
    padding: 1 2;
    height: 100%;
}

/* Full height, not auto: a detail pane that stops halfway down the list it describes
   reads as a rendering fault rather than a pane. */
#side {
    width: 32;
    margin-left: 2;
    background: #191920;
    border: round #2a2a31;
    border-title-color: #6b7280;
    border-title-align: right;
    padding: 0 1;
    height: 100%;
}

#detail {
    height: 1;
}

#keys {
    margin-top: 1;
    height: 1;
}

/* ── narrow (< 76 cols): phones, split panes ──────────────────────────────
   One column. The detail pane is not shrunk, it is dropped - two panes at 48
   columns clipped every label and lost whole rows. */

Screen.-narrow #shell {
    padding: 0 1;
}

/* STACKED, NOT DROPPED. Hiding the pane made the richest tier the least informative one
   at the width the product is most used at - and on the installer chooser the hidden text
   is what each option touches outside the repo, which is that screen's stated reason to
   exist. The original objection stands and is respected: two panes SIDE BY SIDE at this
   width clipped every label. This is one column, which is what the prompt_toolkit tier
   below has always done (tui_chrome._stacked_rows). */
Screen.-narrow #panes {
    layout: vertical;
}

Screen.-narrow #panes > #panel {
    width: 100%;
    padding: 0 1;
    /* Share the column with the pane below rather than taking the whole height. */
    height: 1fr;
}

Screen.-narrow #side {
    width: 100%;
    margin-left: 0;
    margin-top: 1;
    /* Enough to be worth reading, capped so the list it describes stays on screen. */
    height: auto;
    max-height: 40%;
}

Screen.-narrow #brand {
    margin-bottom: 0;
}

Screen.-narrow #keys {
    margin-top: 0;
}
