#!/usr/bin/env bash
# virt-surv2 — the Textual front end, runnable from anywhere.
#
# Deliberately a sibling of `virt-surv`, not a replacement: both drive the same
# install_helper.py engine, so they can be compared on the same machine.
#
#   virt-surv2 --demo       dry run, writes nothing
#   virt-surv2              install / reconfigure
#   virt-surv2 --launch     the launcher screen
#   virt-surv2 --settings   project settings
set -euo pipefail

# The clone this script lives in — resolved through symlinks, so putting a link to it
# on PATH works.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"

PY="${VS_PYTHON:-python3}"
command -v "$PY" >/dev/null 2>&1 || { echo "virt-surv2: no $PY on PATH" >&2; exit 127; }

if [ "${1:-}" = "go" ] || [ "${1:-}" = "engage" ]; then
  # The launcher contract, same as the alias and same as `virt-surv go`: stdout is the
  # decision, 97 means launch nothing, VIRT_SURV_CD_FILE is how the child asks this
  # shell to cd. exec'd rather than run in a subshell so the cd survives.
  shift
  LAUNCH="$("$PY" "$REPO/scripts/virt_team_launcher.py" --launch-command 2>/dev/null || true)"
  [ -n "$LAUNCH" ] || LAUNCH=claude
  CDF="$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/virt-surv2-cd.$$")"
  DECISION="$(cd "$REPO" && VIRT_SURV_CD_FILE="$CDF" "$PY" -m virt_surv2 go)"
  RC=$?
  if [ -s "$CDF" ]; then cd "$(cat "$CDF")" || true; fi
  rm -f "$CDF"
  [ "$RC" -eq 97 ] && exit 0
  exec $LAUNCH ${DECISION:+"$DECISION"} "$@"
fi

cd "$REPO"
exec "$PY" -m virt_surv2 "$@"
